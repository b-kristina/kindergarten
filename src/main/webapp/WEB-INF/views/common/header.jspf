<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <style>
        body{font-family:Arial,sans-serif;margin:0;background:#f6f4ef;color:#1f1f1f;}
        main{max-width:1100px;margin:0 auto;padding:32px 20px 48px;}
        a.button,button,input[type=submit]{display:inline-block;border:0;border-radius:10px;padding:10px 16px;background:#244b6b;color:#fff;text-decoration:none;cursor:pointer;}
        a.button.secondary{background:#65727a;}
        .card{background:#fff;border-radius:18px;box-shadow:0 14px 32px rgba(35,45,55,.08);padding:24px;margin-bottom:20px;}
        table{width:100%;border-collapse:collapse;}
        th,td{padding:12px 10px;border-bottom:1px solid #e7e1d8;text-align:left;vertical-align:top;}
        .grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));}
        label{display:block;font-weight:600;margin:12px 0 6px;}
        input,select{width:100%;box-sizing:border-box;padding:10px 12px;border:1px solid #c9c1b7;border-radius:10px;background:#fff;}
        .error{background:#fdeceb;color:#8a1f11;padding:12px 14px;border-radius:12px;margin-bottom:16px;}
        .success{background:#e8f5e9;color:#1f5a2b;padding:12px 14px;border-radius:12px;margin-bottom:16px;}
        .muted{color:#616161;}
        .actions{display:flex;gap:10px;flex-wrap:wrap;}
        form.inline{display:inline;}
        nav{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:24px;}
        h1,h2,h3{margin-top:0;}
    </style>
</head>
<body>
<main>
    <nav>
        <a class="button" href="<%= request.getContextPath() %>/home">Главная</a>
        <a class="button secondary" href="<%= request.getContextPath() %>/groups">Группы</a>
        <a class="button secondary" href="<%= request.getContextPath() %>/children">Дети</a>
    </nav>