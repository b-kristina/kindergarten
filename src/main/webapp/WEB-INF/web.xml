<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Kindergarten</display-name>

    <listener>
        <listener-class>kindergarten.web.AppContextListener</listener-class>
    </listener>

    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>kindergarten.web.EncodingFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>kindergarten.controller.HomeServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/</url-pattern>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GroupServlet</servlet-name>
        <servlet-class>kindergarten.controller.GroupServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>GroupServlet</servlet-name>
        <url-pattern>/groups</url-pattern>
        <url-pattern>/groups/new</url-pattern>
        <url-pattern>/groups/edit</url-pattern>
        <url-pattern>/groups/save</url-pattern>
        <url-pattern>/groups/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ChildServlet</servlet-name>
        <servlet-class>kindergarten.controller.ChildServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ChildServlet</servlet-name>
        <url-pattern>/children</url-pattern>
        <url-pattern>/children/new</url-pattern>
        <url-pattern>/children/edit</url-pattern>
        <url-pattern>/children/save</url-pattern>
        <url-pattern>/children/delete</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
    </jsp-config>

    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>

</web-app>